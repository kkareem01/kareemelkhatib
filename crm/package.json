{
  "name": "crm-kareemelkhatib",
  "version": "1.0.0",
  "private": true,
  "description": "Personal convenience center at crm.kareemelkhatib.com — Cloudflare Workers + D1 + R2",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "db:migrate:local": "wrangler d1 migrations apply crm-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply crm-db --remote",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@simplewebauthn/server": "^13.1.1"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.20.1",
    "@cloudflare/workers-types": "^5.20260801.1",
    "typescript": "^5.5.4",
    "vitest": "^4.1.10",
    "wrangler": "^4.118.0"
  }
}
